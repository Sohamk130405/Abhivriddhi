{
    "version": 2,
    "rewrites": [
        {
            "source": "/edge/:match*",
            "destination": "https://edge-coral.vercel.app/:match*"
        },
        {
            "source": "/:match*",
            "destination": "https://abhivriddhi.vercel.app/:match*",
            "has": [
                {
                    "type": "header",
                    "key": "host",
                    "value": "abhivriddhi.vercel.app"
                }
            ]
        }
    ]
}